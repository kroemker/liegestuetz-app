<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Base application theme. The Compose UI handles all visual styling;
        this theme exists only to satisfy the Activity window background
        and remove the action bar before Compose takes over.
    -->
    <style name="Theme.Liegestuetz" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
